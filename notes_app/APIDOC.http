
### 1. USER REGISTRATION
POST http://127.0.0.1:8000/api/register/
Content-Type: application/json

{
    "username": "Ishwaryaaa",
    "email": "aishu@gmail.com",
    "password": "aishu@123"
}

### 2. TOKEN LOGIN
POST http://127.0.0.1:8000/api/login/
Content-Type: application/json

{
    "username": "Ishwarya",
    "password": "aishu@123"
}

### 3. GET ALL NOTES
GET http://127.0.0.1:8000/api/notes/
Accept: application/json
Authorization: Token YOUR_TOKEN

### 4. CREATE NOTE
POST http://127.0.0.1:8000/api/notes/
Content-Type: application/json
Authorization: Token YOUR_TOKEN

{
    "title": "Python Language",
    "description": "Python basic to advance"
}

### 5. GET PARTICULAR NOTE
GET http://127.0.0.1:8000/api/notes/1/
Accept: application/json
Authorization: Token YOUR_TOKEN

### 6. UPDATE NOTE
PUT http://127.0.0.1:8000/api/notes/2/
Content-Type: application/json
Authorization: Token YOUR_TOKEN

{
    "title": "Python Notes",
    "description": "Python is a high-level, interpreted programming language known for its simplicity and readability. It supports multiple programming paradigms, including procedural, object-oriented, and functional programming."
}

### 7. DELETE PARTICULAR NOTE
DELETE http://127.0.0.1:8000/api/notes/2/
Authorization: Token YOUR_TOKEN

### 8. USER LOGOUT
POST http://127.0.0.1:8000/api/logout/
Authorization: Token YOUR_TOKEN

### 9. DELETE USER ACCOUNT
DELETE http://127.0.0.1:8000/user/delete/
Authorization: Token YOUR_TOKEN

### 10. JWT LOGIN
POST http://127.0.0.1:8000/api/jwt_login/
Content-Type: application/json

{
    "username": "Ishwaryaaa",
    "password": "aishu@123"
}

